{
  "name": "pomiary-elektryczne-functions",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc && cp -r src/assets lib/",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx firebase-tools emulators:start --only functions",
    "shell": "npm run build && npx firebase-tools functions:shell",
    "deploy": "npx firebase-tools deploy --only functions",
    "logs": "npx firebase-tools functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "typescript": "~5.9.3"
  }
}
